{
  "name": "flytalk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "setup": "node ../scripts/setup.mjs",
    "prepare:data": "node ../scripts/setup.mjs prepare",
    "prepare:assets": "node ../scripts/setup.mjs assets",
    "calibrate": "tsx scripts/calibrate.ts",
    "neural:report": "tsx scripts/report.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
